# 这个仓库的发版设置（工作流读它；其余文件由 dsh-plugins/_ci/sync.sh 同步）
PKG_DIR=plugin
ASSETS=dsh-mac-computer-use.tgz dsh-cu.tgz
TEST_CMD=node tools/test-panel.mjs && swiftc -typecheck tools/dsh-cu.swift && swiftc -typecheck cursor/cursor-overlay.swift
# 日常 DSH 实跑必须通过的系统（空格分隔：macOS Windows）；其余系统的结果只作参考
PLATFORMS=macOS
